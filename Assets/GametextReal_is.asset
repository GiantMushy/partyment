      m_Items: []
  - m_Id: 10558747799973888
    m_Localized: "H\xF3pur 2"
    m_Metadata:
      m_Items: []
  - m_Id: 10558714077769728
    m_Localized: "H\xF3pur 1"
    m_Metadata:
      m_Items: []
  - m_Id: 10559150285385728
    m_Localized: "ME\xD0"
    m_Metadata:
      m_Items: []
  - m_Id: 10559172997541888
    m_Localized: "\xC1 M\xD3TI"
    m_Metadata:
      m_Items: []
  - m_Id: 10559488207876096
    m_Localized: "\xC1s\xF6kun"
    m_Metadata:
      m_Items: []
  - m_Id: 10559633301434368
    m_Localized: "\xDEetta er \xFEar sem leikmenn geta saka\xF0 hver annan um spillingu.
      Ef \xFEeir giska r\xE9tt, stela \xFEeir spillingar stigunum\r\n\r\nSmelltu
      \xE1 leikmanninn sem \xE1sakar"
    m_Metadata:
      m_Items: []
  - m_Id: 10560036592152576
    m_Localized: Vitlaust
    m_Metadata:
      m_Items: []
  - m_Id: 10560167454437376
    m_Localized: Virk Verkefni
    m_Metadata:
      m_Items: []
  - m_Id: 10560386296442880
    m_Localized: "\xD3virk Verkefni"
    m_Metadata:
      m_Items: []
  - m_Id: 10560685098659840
    m_Localized: "Hle\xF0ur..."
    m_Metadata:
      m_Items: []
  - m_Id: 10888662424481792
    m_Localized: "N\xE6sti Umfer\xF0"
    m_Metadata:
      m_Items: []
  - m_Id: 10889828461965312
    m_Localized: "\xDEitt Nafn..."
    m_Metadata:
      m_Items: []
  - m_Id: 10890083345625088
    m_Localized: Nafn
    m_Metadata:
      m_Items: []
  - m_Id: 10890220713275392
    m_Localized: Lykill
    m_Metadata:
      m_Items: []
  - m_Id: 13926200606420992
    m_Localized: "Einhver er a\xF0 \xE1saka!\nVeldu leikmanninn sem hann \xE1sakar
      A\xD0EINS ef \xE1giskunin er r\xE9tt. Ef \xE1giskunin er r\xF6ng e\xF0a ekki
      n\xF3gu n\xE1kv\xE6m, smelltu \xE1 \u201CVitlaust\u201D hnappinn"
    m_Metadata:
      m_Items: []
  - m_Id: 13952925918785536
    m_Localized: "Tungum\xE1l"
    m_Metadata:
      m_Items: []
  - m_Id: 13952998668988416
    m_Localized: "Hlj\xF3\xF0"
    m_Metadata:
      m_Items: []
  - m_Id: 14104880280465408
    m_Localized: Ertu viss?
    m_Metadata:
      m_Items: []
  - m_Id: 14105024811986944
    m_Localized: "J\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 14105977652998144
    m_Localized: Enska
    m_Metadata:
      m_Items: []
  - m_Id: 14106041444167680
    m_Localized: "\xCDslenska"
    m_Metadata:
      m_Items: []
  - m_Id: 14106119298838528
    m_Localized: "\xDE\xFDska"
    m_Metadata:
      m_Items: []
  - m_Id: 14106168728711168
    m_Localized: "Sp\xE6nska"
    m_Metadata:
      m_Items: []
  - m_Id: 14823565923704832
    m_Localized: Stig
    m_Metadata:
      m_Items: []
  - m_Id: 15564877014753280
    m_Localized: "Sl\xE1\xF0u inn n\xF6fn leikmanna\nMin: 3     Max: 8"
    m_Metadata:
      m_Items: []
  - m_Id: 15565102735417344
    m_Localized: "Sl\xE1\xF0u inn nafn..."
    m_Metadata:
      m_Items: []
  - m_Id: 15589930976665600
    m_Localized: "Upprunulega Safni\xF0! Almenn og \xF6rugg Umr\xE6\xF0uefni og Spillingar,
      fullkomi\xF0 fyrir alla h\xF3pa. Byrji\xF0 h\xE9r ef \xFEetta er fyrsti leikurinn
      :)"
    m_Metadata:
      m_Items: []
  - m_Id: 15589967395807232
    m_Localized: "Einungis fyrir okkur \xCDslendinga!"
    m_Metadata:
      m_Items: []
  - m_Id: 15589997452189696
    m_Localized: "Hva\xF0a s\xF6gnvari er s\xFA besti? Hva\xF0a \xE1hryfavaldur hefur
      mest \xE1hryf? "
    m_Metadata:
      m_Items: []
  - m_Id: 15590018847334400
    m_Localized: "Alv\xF6runni p\xF3lits\xEDkt efni. Passi\xF0 vel upp\xE1 hvern
      \xFEi\xF0 spili\xF0 me\xF0!"
    m_Metadata:
      m_Items: []
  - m_Id: 15590069527109632
    m_Localized: Hush Hush
    m_Metadata:
      m_Items: []
  - m_Id: 15628095171059712
    m_Localized: "Banna\xF0 a\xF0 hafa eins n\xF6fn!"
    m_Metadata:
      m_Items: []
  - m_Id: 15700000000000001
    m_Localized: "R\xE9tt"
