    m_Metadata:
      m_Items: []
  - m_Id: 10520057857961984
    m_Localized: Tengjast
    m_Metadata:
      m_Items: []
  - m_Id: 10520576273936384
    m_Localized: "Lotuk\xF3\xF0i"
    m_Metadata:
      m_Items: []
  - m_Id: 10520889928183808
    m_Localized: "B\xED\xF0a eftir leikm\xF6nnum"
    m_Metadata:
      m_Items: []
  - m_Id: 10525874187399168
    m_Localized: "Sl\xE1\xF0u inn Lotuk\xF3\xF0a"
    m_Metadata:
      m_Items: []
  - m_Id: 10520374725046272
    m_Localized: "H\xE9rna eru regglurnar"
    m_Metadata:
      m_Items: []
  - m_Id: 10542488945422336
    m_Localized: Byrja
    m_Metadata:
      m_Items: []
  - m_Id: 10550890358632448
    m_Localized: Stokka
    m_Metadata:
      m_Items: []
  - m_Id: 10556906496323584
    m_Localized: "Haltu e\xF0a smelltu til a\xF0 sj\xE1 Spillinguna \xFE\xEDna\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10557518394945536
    m_Localized: "B\xFAin!"
    m_Metadata:
      m_Items: []
  - m_Id: 10558247130099712
