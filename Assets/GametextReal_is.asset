    m_Metadata:
      m_Items: []
  - m_Id: 2928417928638464
    m_Localized: Alment Nafn
    m_Metadata:
      m_Items: []
  - m_Id: 2929375169474560
    m_Localized: "Veldu frumvarp e\xF0a velji\xF0 saman frumvarp sem leikmenn munu
