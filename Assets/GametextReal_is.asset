    m_Metadata:
      m_Items: []
  - m_Id: 2946846815416320
    m_Localized: "\xC1hugasemi"
    m_Metadata:
      m_Items: []
  - m_Id: 2947211875053568
    m_Localized: "\xDE\xFA getur vali\xF0 hvort \xFE\xFA deilir \xFEessu me\xF0 spilurunum
