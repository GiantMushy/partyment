    m_Metadata:
      m_Items: []
  - m_Id: 10519024050106368
    m_Localized: "B\xFAin!"
    m_Metadata:
      m_Items: []
  - m_Id: 10519730853244928
    m_Localized: "\xC9g er [nafn]"
    m_Metadata:
      m_Items: []
  - m_Id: 10520027818356736
